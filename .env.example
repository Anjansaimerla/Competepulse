# --- Required ---
# Firecrawl API key (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project (https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# OpenAI (embeddings + analysis model)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- Optional: distribution channels ---
# Slack incoming webhook for text alerts
SLACK_WEBHOOK_URL=
# Slack bot token (xoxb-...) required for PDF file uploads
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# SendGrid email delivery
SENDGRID_API_KEY=
SENDER_EMAIL=
# Comma-separated list of recipients
RECIPIENT_EMAILS=

# --- Optional: behavior flags ---
# Set to true to bypass all external delivery APIs and save payloads locally
DISTRIBUTION_DRY_RUN=false
# Override the weekly target list (JSON file path); defaults to targets.json
COMPETEPULSE_TARGETS=targets.json
# LLM model override (default: gpt-4o)
COMPETEPULSE_MODEL=gpt-4o
